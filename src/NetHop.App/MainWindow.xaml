<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NetHop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetHop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/NetHop-32.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="NetHop" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Dashboard" Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Profiles" Content="Profiles" Tag="Profiles">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Adapters" Content="Network adapters" Tag="Adapters">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE839;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Automations" Content="Automations" Tag="Automations">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Integrations" Content="Integrations" Tag="Integrations">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Same left edge and maximum width as the pages below. -->
                <Grid Margin="36,0,36,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="{StaticResource PageMaxWidth}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <InfoBar x:Name="ConnectionInfo" Margin="0,12,0,0" IsClosable="False" IsOpen="False" />
                        <!-- Standard (non-admin) accounts: the service only allows reading. -->
                        <InfoBar x:Uid="Main_ReadOnly" x:Name="ReadOnlyInfo" Margin="0,12,0,0" Severity="Warning" IsClosable="False" IsOpen="False"
                                 Title="Read-only" Message="This account is not an administrator. Until you run NetHop as administrator you can view profiles, rules and adapters, but not change them.">
                            <InfoBar.ActionButton>
                                <Button x:Uid="Main_RestartAsAdmin" Content="Restart as administrator" Click="OnRestartAsAdminClick" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Grid>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
