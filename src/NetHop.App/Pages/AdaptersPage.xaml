<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetHop.App.Pages.AdaptersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Style="{StaticResource PageGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <!-- Title and controls in their own columns, so they never overlap in a narrow window. -->
                <Grid Margin="0,0,0,16" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Adapters_Title" Text="Network adapters" Style="{StaticResource TitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <ToggleSwitch x:Uid="Adapters_ShowVirtual" x:Name="ShowVirtual" OnContent="Virtual adapters shown" OffContent="Virtual adapters hidden" Toggled="OnShowVirtualToggled" />
                        <Button x:Uid="Adapters_Refresh" Click="OnRefreshClick" ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ErrorInfo" Severity="Error" IsClosable="True" />
                <StackPanel x:Name="AdapterList" Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
