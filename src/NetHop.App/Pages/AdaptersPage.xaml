<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetHop.App.Pages.AdaptersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">
            <Grid Margin="0,0,0,16">
                <TextBlock Text="Network adapters" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
                    <ToggleSwitch x:Name="ShowVirtual" OnContent="Virtual adapters shown" OffContent="Virtual adapters hidden" Toggled="OnShowVirtualToggled" />
                    <Button Click="OnRefreshClick" ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorInfo" Severity="Error" IsClosable="True" />
            <StackPanel x:Name="AdapterList" Spacing="{StaticResource SettingsCardSpacing}" />
        </StackPanel>
    </ScrollViewer>
</Page>
