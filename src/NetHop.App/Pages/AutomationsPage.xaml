<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetHop.App.Pages.AutomationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="{StaticResource PageMaxWidth}" />
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Uid="Automations_Title" Text="Automations" Style="{StaticResource PageTitleStyle}" />

            <toolkit:SettingsCard x:Uid="Automations_Run" Grid.Row="1" Header="Run automations"
                                  Description="NetHop's own rule engine: no Power Automate needed. Rules can still start Power Automate flows.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE945;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="RunSwitch" Toggled="OnRunToggled" />
            </toolkit:SettingsCard>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock x:Uid="Automations_Save" Text="Save rules" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddRuleButton" Click="OnAddRuleClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="Automations_AddRule" Text="Add rule" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <SelectorBar x:Name="ViewSelector" Grid.Row="3" SelectionChanged="OnViewChanged">
                <SelectorBarItem x:Uid="Automations_FormView" x:Name="FormViewItem" Text="Form" IsSelected="True">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE70F;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Uid="Automations_YamlView" x:Name="YamlViewItem" Text="YAML">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE943;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <ScrollViewer x:Name="FormScroller" Grid.Row="4">
                <ContentControl x:Name="FormHost" HorizontalContentAlignment="Stretch" Margin="0,0,16,0" />
            </ScrollViewer>
            <TextBox x:Name="Editor" Grid.Row="4" Style="{StaticResource CodeEditorStyle}" Visibility="Collapsed" TextChanged="OnEditorTextChanged" />

            <InfoBar x:Name="Result" Grid.Row="5" IsClosable="True" />
        </Grid>
    </Grid>
</Page>
