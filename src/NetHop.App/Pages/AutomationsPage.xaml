<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetHop.App.Pages.AutomationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid Margin="{StaticResource PageMargin}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Automations" Style="{StaticResource PageTitleStyle}" />

        <toolkit:SettingsCard Grid.Row="1" Header="Run automations"
                              Description="NetHop's own rule engine: no Power Automate needed. Rules can still start Power Automate flows.">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE945;" />
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="RunSwitch" Toggled="OnRunToggled" />
        </toolkit:SettingsCard>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Save rules" />
                </StackPanel>
            </Button>
            <Button Click="OnExampleClick" Content="Insert example rule" />
        </StackPanel>

        <TextBox x:Name="Editor" Grid.Row="3" Style="{StaticResource CodeEditorStyle}" />

        <InfoBar x:Name="Result" Grid.Row="4" IsClosable="True" />
    </Grid>
</Page>
