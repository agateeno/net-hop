<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetHop.App.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ipc="using:NetHop.Ipc"
    xmlns:app="using:NetHop.App"
    SizeChanged="OnSizeChanged">

    <Page.Resources>
        <!-- One profile, in the list (wide windows) and in the drop-down (narrow ones). -->
        <DataTemplate x:Key="ProfileItemTemplate" x:DataType="ipc:ProfileSummary">
            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                <Grid Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center"
                      Background="{x:Bind app:XamlHelpers.ProfileBrush(Color)}">
                    <FontIcon Glyph="{x:Bind app:XamlHelpers.GlyphOrDefault(Icon)}" FontSize="14" Visibility="{x:Bind app:XamlHelpers.PlainGlyphVisibility(Icon, Color)}" />
                    <FontIcon Glyph="{x:Bind app:XamlHelpers.GlyphOrDefault(Icon)}" FontSize="14" Foreground="White" Visibility="{x:Bind app:XamlHelpers.WhiteGlyphVisibility(Icon, Color)}" />
                    <Image Source="{x:Bind app:XamlHelpers.ProfileImage(Icon)}" Margin="3" Visibility="{x:Bind app:XamlHelpers.ImageVisibility(Icon)}" />
                </Grid>
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          Visibility="{x:Bind IsActive}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.ColumnDefinitions>
            <!-- Very wide windows lift the maximum (OnSizeChanged): the editor fills the window; adapters then go in two
                 columns once the form is wide enough (OnFormSizeChanged). -->
            <ColumnDefinition x:Name="PageColumn" MaxWidth="{StaticResource PageMaxWidth}" />
        </Grid.ColumnDefinitions>

        <!-- Set by OnSizeChanged. The groups must sit on the page's root element: VisualStateManager.GoToState(page)
             looks only there, and silently does nothing when they are further down. -->
        <VisualStateManager.VisualStateGroups>
            <!-- Wide: the list on the left. Narrow: a drop-down above the editor, which gets the whole width. -->
            <VisualStateGroup>
                <VisualState x:Name="WideLayout" />
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="ListPanel.Visibility" Value="Collapsed" />
                        <Setter Target="ListSeparator.Visibility" Value="Collapsed" />
                        <Setter Target="ListColumn.Width" Value="0" />
                        <Setter Target="SeparatorColumn.Width" Value="0" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="0" />
                        <Setter Target="PickerPanel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- Very narrow: the secondary buttons show only their icon (their tooltips give the full meaning). -->
            <VisualStateGroup>
                <VisualState x:Name="LabeledButtons" />
                <VisualState x:Name="IconButtons">
                    <VisualState.Setters>
                        <Setter Target="PickerNewText.Visibility" Value="Collapsed" />
                        <Setter Target="PickerCaptureText.Visibility" Value="Collapsed" />
                        <Setter Target="PreviewText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="LayoutRoot" ColumnSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="240" />
                <ColumnDefinition x:Name="SeparatorColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="Profiles_Title" Grid.ColumnSpan="3" Text="Profiles" Style="{StaticResource PageTitleStyle}" />

            <!-- Narrow windows: profile drop-down and the two "new profile" buttons -->
            <Grid x:Name="PickerPanel" Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="8" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Uid="Profiles_Picker" x:Name="ProfilePicker" HorizontalAlignment="Stretch" PlaceholderText="Select a profile"
                          ItemTemplate="{StaticResource ProfileItemTemplate}" SelectionChanged="OnSelectionChanged" />
                <Button x:Uid="Profiles_New" Grid.Column="1" Click="OnNewClick" ToolTipService.ToolTip="New empty profile">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="Profiles_NewText" x:Name="PickerNewText" Text="New" />
                    </StackPanel>
                </Button>
                <Button x:Uid="Profiles_Capture" Grid.Column="2" Click="OnCaptureClick"
                        ToolTipService.ToolTip="New profile from the current configuration of all adapters">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE722;" FontSize="14" />
                        <TextBlock x:Uid="Profiles_CaptureText" x:Name="PickerCaptureText" Text="Current" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Wide windows: profile list -->
            <Grid x:Name="ListPanel" Grid.Row="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Two equal buttons that always fit the column; the tooltips give the full meaning. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="Profiles_New" HorizontalAlignment="Stretch" Click="OnNewClick" ToolTipService.ToolTip="New empty profile">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Uid="Profiles_NewText" Text="New" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Profiles_Capture" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnCaptureClick"
                            ToolTipService.ToolTip="New profile from the current configuration of all adapters">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE722;" FontSize="14" />
                            <TextBlock x:Uid="Profiles_CaptureText" Text="Current" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Dragging rearranges the profiles: the same order as the dashboard and the tray. -->
                <ListView x:Name="ProfileList" Grid.Row="1" ItemTemplate="{StaticResource ProfileItemTemplate}" SelectionChanged="OnSelectionChanged"
                          CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="OnProfilesReordered" />
            </Grid>

            <!-- Separator between the list and the editor -->
            <Rectangle x:Name="ListSeparator" Grid.Row="2" Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Editor: form or YAML -->
            <Grid x:Name="EditorPanel" Grid.Row="2" Grid.Column="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock x:Uid="Profiles_Save" Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ApplyButton" Click="OnApplyClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Uid="Profiles_Apply" Text="Apply" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Profiles_Preview" x:Name="DryRunButton" Click="OnDryRunClick" ToolTipService.ToolTip="Show what would change, without changing anything">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                            <TextBlock x:Uid="Profiles_PreviewText" x:Name="PreviewText" Text="Preview" />
                        </StackPanel>
                    </Button>
                    <!-- Less frequent actions in a menu: the toolbar stays short in every language, and Delete is out of the way. -->
                    <DropDownButton x:Uid="Profiles_More" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Uid="Profiles_Duplicate" x:Name="DuplicateItem" Text="Duplicate" Click="OnDuplicateClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Profiles_Export" x:Name="ExportItem" Text="Export" Click="OnExportClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="Profiles_Delete" x:Name="DeleteItem" Text="Delete" Click="OnDeleteClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <SelectorBar x:Name="ViewSelector" Grid.Row="1" SelectionChanged="OnViewChanged">
                    <SelectorBarItem x:Uid="Profiles_FormView" x:Name="FormViewItem" Text="Form" IsSelected="True">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE70F;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Uid="Profiles_YamlView" x:Name="YamlViewItem" Text="YAML">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE943;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <ScrollViewer x:Name="FormScroller" Grid.Row="2" SizeChanged="OnFormSizeChanged">
                    <ContentControl x:Name="FormHost" HorizontalContentAlignment="Stretch" Margin="0,0,16,0" />
                </ScrollViewer>
                <TextBlock x:Uid="Profiles_Empty" x:Name="EmptyText" Grid.Row="2" Text="Select a profile, or create a new one."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox x:Name="Editor" Grid.Row="2" Style="{StaticResource CodeEditorStyle}" Visibility="Collapsed"
                         TextChanged="OnEditorTextChanged" />

                <!-- A long preview or list of issues scrolls instead of pushing the editor off a short window. -->
                <ScrollViewer Grid.Row="3" MaxHeight="240">
                    <InfoBar x:Name="Result" IsClosable="True" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>