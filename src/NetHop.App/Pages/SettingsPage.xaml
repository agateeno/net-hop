<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetHop.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <toolkit:SettingsCard Header="Start with Windows" Description="NetHop starts in the notification area when you sign in.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartupSwitch" Toggled="OnStartupToggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Name="ServiceCard" Header="NetHop service" Description="-">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE912;" /></toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard x:Name="AboutCard" Header="NetHop" Description="Network profiles for Windows">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/NetHop.png" />
                </toolkit:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/agateeno/net-hop" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
