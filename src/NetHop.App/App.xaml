<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NetHop.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Same spacing as PowerToys settings pages. -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Thickness x:Key="PageMargin">36,24,36,36</Thickness>
            <x:Double x:Key="PageMaxWidth">1000</x:Double>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,6" />
            </Style>

            <Style x:Key="CodeEditorStyle" TargetType="TextBox">
                <!-- Icon fonts as fallback: profile icons are Segoe Fluent Icons glyphs, which code fonts draw as a box. -->
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
