<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 for the Logi Actions plugin, which runs in Logi Plugin Service's .NET 8 runtime. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- GenerateShape is only needed by the MessagePack formatter; NetHop uses System.Text.Json. -->
    <NoWarn>$(NoWarn);StreamJsonRpc0008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetHop.Core\NetHop.Core.csproj" />
  </ItemGroup>
</Project>
