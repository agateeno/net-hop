<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows SDK projections for the mobile hotspot (WinRT). Same version as the app: they share one publish folder. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- StreamJsonRpc's VS.Threading dependency declares WPF for -windows targets; NetHop never uses it,
         and skipping it keeps ~50 MB of WPF out of the self-contained build (as in the app). -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Management.Infrastructure" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetHop.Core\NetHop.Core.csproj" />
  </ItemGroup>
</Project>
