<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers" (paste it into the SignPath project with that slug).
  The artifact is the zip CI makes of the two MSIs (msi/) and the Power Automate module (power-automate/NetHop.cab).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <msi-file-set>
      <include path="msi/*.msi" min-matches="2" max-matches="2" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </msi-file-set>
    <cab-file path="power-automate/NetHop.cab">
      <authenticode-sign />
    </cab-file>
  </zip-file>
</artifact-configuration>
