<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "binaries" (paste it into the SignPath project with that slug).
  The artifact is the zip CI makes of out/sign: NetHop's own .exe and .dll files, flat, before they go into the MSIs.
  The .NET and Windows App SDK files are already signed by Microsoft and are not in it.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" max-matches="unbounded" />
      <include path="*.dll" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
