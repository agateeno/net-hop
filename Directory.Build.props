<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the Windows-only projects (Engine, Service, Cli) compile on macOS/Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>agateeno</Authors>
    <Product>NetHop</Product>
    <Copyright>Copyright (c) 2026 agateeno</Copyright>
    <Version>0.1.0</Version>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- NetHop ships English and Italian: skip the other satellite assemblies of third-party packages. -->
    <SatelliteResourceLanguages>en;it</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
