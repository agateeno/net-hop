# NetHop profile: static IPv4 + IPv6 on the docking-station NIC, Wi-Fi off.
schema: 1
id: 3f2b6c1e-8d4a-4b7e-9a51-2c6d0e7f1a10
name: Office
description: Docking station at the office
icon: ""
color: "#0078D4"
adapters:
  - match:
      name: Ethernet
      mac: 00-1A-2B-3C-4D-5E
    state: enabled
    ipv4:
      mode: static
      addresses:
        - 192.168.10.50/24
        - 10.20.0.5/16
      gateways:
        - 192.168.10.1
      dns:
        mode: static
        servers: [192.168.10.1, 1.1.1.1]
    ipv6:
      mode: static
      addresses:
        - 2001:db8:10::50/64
      gateways:
        - fe80::1
      dns:
        mode: static
        servers: [2606:4700:4700::1111]
  - match:
      name: Wi-Fi
    state: disabled
