<Project Sdk="WixToolset.Sdk/6.0.2">
  <!--
    Per-machine MSI. Build it after publishing the binaries into one folder (see .github/workflows/ci.yml):

      dotnet build installer/NetHop.Installer.wixproj -c Release -p:NetHopBinDir=<publish folder> -p:ProductVersion=0.1.0 [-p:InstallerPlatform=arm64]

    WiX 6 on purpose: WiX 7 requires every build to accept the Open Source Maintenance Fee EULA
    (AcceptEula=wix7), which is a decision for the project owner. See docs/installer.md.
  -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <NetHopBinDir Condition="'$(NetHopBinDir)' == ''">$(MSBuildThisFileDirectory)..\out\bin</NetHopBinDir>
    <!-- x64 or arm64; publish the binaries for the same architecture. -->
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <OutputName>NetHop-$(ProductVersion)-$(InstallerPlatform)</OutputName>
    <!-- One intermediate folder per platform: otherwise the second platform's build is skipped as up to date. -->
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\$(InstallerPlatform)\</IntermediateOutputPath>
    <!-- ICE03 rejects the Language value Windows reports for some harvested satellite assemblies; it is informational only. -->
    <SuppressIces>ICE03</SuppressIces>
    <DefineConstants>ProductVersion=$(ProductVersion);BinDir=$(NetHopBinDir);RepoDir=$(MSBuildThisFileDirectory)..</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
