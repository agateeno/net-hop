<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Never change the UpgradeCode: it ties every NetHop version together for upgrades. -->
  <Package Name="NetHop"
           Manufacturer="agateeno"
           Version="$(ProductVersion)"
           UpgradeCode="7C3E9A51-2B4D-4F6E-8A1C-5D9B0E2F4A63"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of NetHop is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NetHop.ico" SourceFile="$(RepoDir)\src\NetHop.App\Assets\NetHop.ico" />
    <Property Id="ARPPRODUCTICON" Value="NetHop.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/agateeno/net-hop" />
    <Property Id="ARPHELPLINK" Value="https://github.com/agateeno/net-hop/issues" />

    <!-- The tray app keeps running when its window is closed: ask it to close, then end it. -->
    <util:CloseApplication Id="CloseTrayApp" Target="NetHop.App.exe" CloseMessage="yes"
                           TerminateProcess="0" Timeout="3" RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NetHop" />
      <Directory Id="WindowsPowerShellFolder" Name="WindowsPowerShell">
        <Directory Id="PowerShellModulesFolder" Name="Modules">
          <Directory Id="NetHopModuleFolder" Name="NetHop" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="NetHop" Description="App and command line. The NetHop service is installed off: turn it on in NetHop's Settings for automations." Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Binaries" />
      <ComponentRef Id="Service" />
      <ComponentRef Id="PathEnvironment" />
      <ComponentRef Id="ShellIntegration" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Feature Id="PowerShellModule" Title="PowerShell module"
             Description="Get-NetHopProfile, Set-NetHopProfile and friends, for scripts and Power Automate Desktop." Level="1">
      <ComponentGroupRef Id="PowerShellModuleFiles" />
    </Feature>

    <!-- "Launch NetHop" on the last page: the first launch creates %USERPROFILE%\NetHop Profiles and pins it to Quick Access. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NetHop" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- SetProperty, not Property: a Property value is not resolved, so [INSTALLFOLDER] would stay literal. -->
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]NetHop.App.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchNetHop" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- Uninstall: the app (as the user, before its files are removed) removes its startup entry and its Windows 11
         context menu package, and asks whether to delete %USERPROFILE%\NetHop Profiles. Not on upgrades. In silent
         mode (UILevel 2) it runs with the quiet switch: no question, and the folder is kept. -->
    <CustomAction Id="UninstallUserCleanup" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]NetHop.App.exe&quot; --uninstall"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <CustomAction Id="UninstallUserCleanupQuiet" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]NetHop.App.exe&quot; --uninstall --quiet"
                  Execute="immediate" Impersonate="yes" Return="ignore" />

    <!-- The NetHop service is off by default: the app registers it when it is turned on in Settings, so the MSI does
         not own it. Found before the previous version is removed (which stops it, and up to 0.5 also removed it),
         it is registered again and started once the new files are in place. -->
    <Property Id="SERVICEINSTALLED" Secure="yes">
      <RegistrySearch Id="ServiceImagePath" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\NetHop" Name="ImagePath"
                      Type="raw" Bitness="always64" />
    </Property>
    <CustomAction Id="RestoreService" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]NetHop.App.exe&quot; --install-service"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Uninstall (not upgrades): the service and every user's startup task (a scheduled task without the service). -->
    <CustomAction Id="UninstallMachineCleanup" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]NetHop.App.exe&quot; --uninstall-machine"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UninstallUserCleanup" Before="InstallInitialize"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &lt;&gt; 2" />
      <Custom Action="UninstallUserCleanupQuiet" Before="InstallInitialize"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel = 2" />
      <Custom Action="UninstallMachineCleanup" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RestoreService" Before="InstallFinalize"
              Condition="SERVICEINSTALLED AND NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <UI>
      <ui:WixUI Id="WixUI_FeatureTree" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNetHop"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(RepoDir)\installer\License.rtf" />
  </Package>

  <Fragment>
    <!-- Everything published into one folder (one shared .NET runtime), except the service executable,
         which is the key file of the component that stops the service while its files are replaced. -->
    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">
      <Files Include="$(BinDir)\**">
        <Exclude Files="$(BinDir)\NetHop.Service.exe" />
        <Exclude Files="$(BinDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- Registered by the app (Settings, NetHop service), not here: see SERVICEINSTALLED. Stopping a service that does
         not exist does nothing. -->
    <Component Id="Service" Directory="INSTALLFOLDER">
      <File Id="ServiceExe" Source="$(BinDir)\NetHop.Service.exe" KeyPath="yes" />
      <ServiceControl Id="NetHopServiceControl" Name="NetHop" Stop="both" Wait="yes" />
    </Component>

    <!-- nethop.exe on the system PATH. -->
    <Component Id="PathEnvironment" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM" Key="Software\NetHop" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
    </Component>

    <!-- .nethop files and nethop:// links for every user. -->
    <Component Id="ShellIntegration" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM" Key="Software\Classes\.nethop" Value="NetHop.Profile" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.nethop" Name="Content Type" Value="application/x-yaml" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile" Value="NetHop profile" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile\shell" Value="open" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile\DefaultIcon" Value="[INSTALLFOLDER]Assets\NetHopFile.ico,0" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile\shell\open\command" Value="&quot;[INSTALLFOLDER]NetHop.App.exe&quot; &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile\shell\edit\command" Value="notepad.exe &quot;%1&quot;" Type="string" />
      <!-- "Apply with NetHop" under "Show more options". The first-level Windows 11 entry comes from
           NetHop.ContextMenu.msix, which the app registers per user (see Services/ContextMenuPackage.cs). -->
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile\shell\apply" Value="Apply with NetHop" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile\shell\apply" Name="Icon" Value="[INSTALLFOLDER]NetHop.App.exe,0" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\NetHop.Profile\shell\apply\command" Value="&quot;[INSTALLFOLDER]NetHop.App.exe&quot; --apply &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\nethop" Value="URL:NetHop" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\nethop" Name="URL Protocol" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\nethop\DefaultIcon" Value="[INSTALLFOLDER]NetHop.App.exe,0" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\nethop\shell\open\command" Value="&quot;[INSTALLFOLDER]NetHop.App.exe&quot; &quot;%1&quot;" Type="string" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="NetHopShortcut" Name="NetHop" Description="Network profiles for Windows"
                Target="[INSTALLFOLDER]NetHop.App.exe" WorkingDirectory="INSTALLFOLDER" Icon="NetHop.ico" />
      <!-- Windows Installer treats the Start menu as part of the user profile (ICE38/ICE43), so the key path is in HKCU. -->
      <RegistryValue Root="HKCU" Key="Software\NetHop" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="PowerShellModuleFiles" Directory="NetHopModuleFolder">
      <Component>
        <File Source="$(RepoDir)\src\NetHop.PowerShell\NetHop.psd1" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(RepoDir)\src\NetHop.PowerShell\NetHop.psm1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
